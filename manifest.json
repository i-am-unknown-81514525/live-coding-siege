{
    "display_information": {
        "name": "LiveCoding"
    },
    "features": {
        "app_home": {
            "home_tab_enabled": true,
            "messages_tab_enabled": false,
            "messages_tab_read_only_enabled": true
        },
        "bot_user": {
            "display_name": "LiveCoding",
            "always_online": false
        },
        "slash_commands": [
            {
                "command": "/user",
                "description": "<user_mention|user_id|slack_user_id>? | View siege user detail",
                "should_escape": true
            },
            {
                "command": "/proj",
                "description": "<proj_id> | View siege project",
                "should_escape": true
            },
            {
                "command": "/project",
                "description": "<proj_id> | View siege project",
                "should_escape": true
            },
            {
                "command": "/global",
                "description": "| View the total hours everyone have completed this week",
                "should_escape": false
            },
            {
                "command": "/lb",
                "description": "<lb_option>? | View the total hours everyone have completed this week",
                "should_escape": false
            },
            {
                "command": "/leaderboard",
                "description": "<lb_option>? | View the total hours everyone have completed this week",
                "should_escape": false
            },
            {
                "command": "/stats",
                "description": "| View stats for each week",
                "should_escape": false
            },
            {
                "command": "/siege_stats",
                "description": "| View stats for each week",
                "should_escape": false
            },
            {
                "command": "/help",
                "description": "<prefix>? | Help command to hopefully answer your random question?",
                "should_escape": false
            },
            {
                "command": "/searchs",
                "description": "<keyword>? | Search Siege project by keywords",
                "should_escape": false
            },
            {
                "command": "/define",
                "description": "<word> | Get definition of a word",
                "should_escape": false
            },
            {
                "command": "/proj_details",
                "description": "<proj_id> | View siege project details",
                "should_escape": false
            },
            {
                "command": "/siege_shop",
                "description": "| View Siege Shop items",
                "should_escape": false
            },
            {
                "command": "/user_details",
                "description": "<user_id>? | View siege user details",
                "should_escape": false
            },
            {
                "command": "/graph",
                "description": "<option>? | Generate various graphs for siege data",
                "should_escape": false
            }
        ]
    },
    "oauth_config": {
        "scopes": {
            "bot": [
                "app_mentions:read",
                "calls:read",
                "calls:write",
                "channels:history",
                "chat:write",
                "commands",
                "files:read",
                "groups:history",
                "im:history",
                "mpim:history",
                "users.profile:read",
                "users:read",
                "workflow.steps:execute",
                "files:write"
            ]
        }
    },
    "settings": {
        "event_subscriptions": {
            "bot_events": [
                "app_mention",
                "message.channels",
                "message.groups",
                "message.im",
                "message.mpim",
                "user_huddle_changed",
                "workflow_step_execute"
            ]
        },
        "interactivity": {
            "is_enabled": true
        },
        "org_deploy_enabled": false,
        "socket_mode_enabled": true,
        "token_rotation_enabled": false
    }
}